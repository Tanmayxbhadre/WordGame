# ==========================================
# WordShift Environment Configuration
# ==========================================

# Supabase (Public - safe for client bundles)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase (Server-only - NEVER expose in client bundles)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# App URLs & Cron Security
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=replace-with-random-64-char-secret

# Expo Mobile App (Public - safe for client bundles)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
EXPO_PUBLIC_API_URL=http://localhost:3000
